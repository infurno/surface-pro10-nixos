// =============================================================================
// Surface Pro 10 for Business - Niri Configuration (niri-tablet enabled)
// =============================================================================

// Display: 13" PixelSense Flow (2880x1920, 3:2, 120Hz)
output "eDP-1" {
    mode "2880x1920@120.000"
    scale 1.75
    transform "normal"
    variable-refresh-rate
}

// Input Configuration: Touchscreen & Surface Type Cover Touchpad
input {
    touch {
        map-to-output "eDP-1"
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        scroll-method "two-finger"
    }
    mouse {
        accel-speed 0.0
    }
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
    }
}

// -----------------------------------------------------------------------------
// niri-tablet Touchscreen Gestures & Edge Swipes
// -----------------------------------------------------------------------------
gestures {
    // Show visual feedback dots while a multi-finger touch gesture is active
    show-touch-points "gestures"

    // Multi-finger touchscreen gestures
    touchscreen-swipe {
        // Base finger count for continuous interactions
        fingers 3

        // Horizontal 3-finger drag: "resize-column" for 1:1 window width tracking,
        // or "move-view" to glide across the horizontal window ribbon.
        horizontal-swipe "resize-column"

        // Discrete gestures (trigger on finger lift)
        tap             { maximize-column; }
        tap-more        { toggle-overview; }
        swipe-more-down { close-window; }
        swipe-more-up   { fullscreen-window; }

        // Press and hold ~400ms, then swipe: moves focused window across columns/workspaces
        hold {
            left  { move-column-left; }
            right { move-column-right; }
            up    { move-window-to-workspace-up; }
            down  { move-window-to-workspace-down; }
        }
    }

    // Single-finger edge swipes
    touchscreen-edge-swipe {
        // Bottom edge swipe up: Toggle on-screen keyboard
        bottom { spawn "niri-osk"; }
        // Top edge swipe down: Toggle Niri window overview
        top    { toggle-overview; }
        // Left edge swipe: Navigate left column
        left   { focus-column-left; }
        // Right edge swipe: Navigate right column
        right  { focus-column-right; }
    }
}

// -----------------------------------------------------------------------------
// Layout & Appearance
// -----------------------------------------------------------------------------
layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#7aa2f7"
        inactive-color "#414868"
    }

    border {
        off
    }
}

// -----------------------------------------------------------------------------
// Startup Services
// -----------------------------------------------------------------------------
spawn-at-startup "waybar"
spawn-at-startup "mako"

// -----------------------------------------------------------------------------
// Window Rules
// -----------------------------------------------------------------------------
window-rule {
    match app-id="wvkbd"
    open-floating true
}

window-rule {
    match app-id="fuzzel"
    open-floating true
}

// -----------------------------------------------------------------------------
// Keybindings (Keyboard / Type Cover Shortcuts)
// -----------------------------------------------------------------------------
binds {
    // Core application binds
    Mod+Return { spawn "alacritty"; }
    Mod+Space  { spawn "fuzzel"; }
    Mod+Q      { close-window; }
    Mod+K      { spawn "niri-osk"; }
    Mod+F      { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Tab    { toggle-overview; }

    // Column & Workspace Navigation
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }
    Mod+Up     { focus-workspace-up; }
    Mod+Down   { focus-workspace-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-to-workspace-up; }
    Mod+Shift+Down  { move-window-to-workspace-down; }

    // Audio & Volume controls (Surface hardware volume rocker & keyboard keys)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // Display Brightness controls
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}
